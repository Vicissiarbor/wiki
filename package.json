{
  "name": "search-ladr",
  "version": "2.0.0",
  "private": true,
  "description": "SearchLADR - a static, retro, dependency-free glossary site: type a concept name (exact or regex) or browse the A-Z index.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "preview": "node tools/serve.js --port 8080 --root web",
    "gen:pinyin": ".tools/venv/bin/python tools/gen_pinyin_table.py"
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
